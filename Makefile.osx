# ==============================================================================
# argo-ebpf - macOS Cross Development Makefile
# ==============================================================================

BINARY_NAME=argo-ebpf
BUILD_DIR=bin
CMD_DIR=./cmd/analyzer
IFACE?=eth0
API_ADDR?=:8080

# 1. Rileva la directory di Homebrew in base all'architettura (ARM vs Intel)
HOMEBREW_PREFIX := $(shell brew --prefix 2>/dev/null || ( [ -d /opt/homebrew ] && echo /opt/homebrew || echo /usr/local ))

# 2. Trova il binario di Clang (forziamo l'uso di Homebrew llvm se presente)
CLANG_BIN := $(firstword $(wildcard $(HOMEBREW_PREFIX)/Cellar/llvm/*/bin/clang) \
                        $(wildcard $(HOMEBREW_PREFIX)/opt/llvm/bin/clang))

STRIP_BIN := $(firstword $(wildcard $(HOMEBREW_PREFIX)/Cellar/llvm/*/bin/llvm-strip) \
                        $(wildcard $(HOMEBREW_PREFIX)/opt/llvm/bin/llvm-strip))

# Assegnazione forte (:=) se i binari Homebrew esistono, altrimenti fallback
ifneq ($(CLANG_BIN),)
    CLANG := $(CLANG_BIN)
else
    CLANG := clang
endif

ifneq ($(STRIP_BIN),)
    LLVM_STRIP := $(STRIP_BIN)
else
    LLVM_STRIP := llvm-strip
endif

# Esporta le variabili per go generate e bpf2go
export CLANG
export LLVM_STRIP

# Modifica del PATH inserendo LLVM di Homebrew in testa
ifneq ($(CLANG_BIN),)
    LLVM_PATH := $(shell dirname $(CLANG_BIN))
    export PATH := $(LLVM_PATH):$(PATH)
endif

GO ?= go

.PHONY: all generate build run test lint clean help

## all: Compila eBPF e genera il binario (default)
all: generate build

## generate: Compila il C eBPF e genera i binding Go
generate:
	@echo "==> Usando CLANG: $(CLANG)"
	@echo "==> Usando LLVM_STRIP: $(LLVM_STRIP)"
	@echo "==> Generazione binding eBPF (bpf2go)..."
	CLANG="$(CLANG)" LLVM_STRIP="$(LLVM_STRIP)" $(GO) generate ./internal/infrastructure/ebpf/...

## build: Compila il binario Go finale cross-compilato per Linux amd64
build: generate
	@echo "==> Compilazione del binario $(BINARY_NAME) per Linux/amd64..."
	@mkdir -p $(BUILD_DIR)
	# Forziamo GOOS e GOARCH per la cross-compilazione, disabilitando CGO se non necessario
	CGO_ENABLED=0 GOOS=linux GOARCH=amd64 $(GO) build -v -ldflags="-w -s" -o $(BUILD_DIR)/$(BINARY_NAME) $(CMD_DIR)
	@echo "==> Build completata per Linux: $(BUILD_DIR)/$(BINARY_NAME)"

## test: Esegue i test di unità Go
test:
	$(GO) test -v -race ./...

## lint: Esegue la verifica sintattica del codice Go
lint:
	$(GO) vet ./...

## clean: Rimuove il binario e gli artefatti eBPF generati
clean:
	@echo "==> Pulizia artefatti..."
	rm -rf $(BUILD_DIR)
	rm -f internal/infrastructure/ebpf/bpf_bpfel.go internal/infrastructure/ebpf/bpf_bpfel.o internal/infrastructure/ebpf/bpf_bpfeb.go internal/infrastructure/ebpf/bpf_bpfeb.o

## help: Mostra questo messaggio di aiuto
help:
	@echo "Utilizzo: make [target]"
	@echo ""
	@sed -n 's/^##//p' $(MAKEFILE_LIST) | column -t -s ':' | sed -e 's/^/ /'