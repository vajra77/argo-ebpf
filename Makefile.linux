# ==============================================================================
# argo-ebpf - Linux Native Makefile
# ==============================================================================

BINARY_NAME=argo-ebpf
BUILD_DIR=bin
CMD_DIR=./cmd/analyzer
IFACE?=eth0
API_ADDR?=:8080

GO?=go
CLANG?=clang
LLVM_STRIP?=llvm-strip

.PHONY: all generate build run test lint clean help

## all: Compila eBPF e genera il binario (default)
all: generate build

## generate: Compila il C eBPF e genera i binding Go
generate:
	@echo "==> Generazione binding eBPF (bpf2go)..."
	CLANG="$(CLANG)" LLVM_STRIP="$(LLVM_STRIP)" $(GO) generate ./bpf/...

## build: Compila il binario Go finale
build: generate
	@echo "==> Compilazione del binario $(BINARY_NAME)..."
	@mkdir -p $(BUILD_DIR)
	$(GO) build -v -ldflags="-w -s" -o $(BUILD_DIR)/$(BINARY_NAME) $(CMD_DIR)
	@echo "==> Build completata: $(BUILD_DIR)/$(BINARY_NAME)"

## test: Esegue i test di unità Go
test:
	$(GO) test -v -race ./...

## lint: Esegue la verifica sintattica del codice Go
lint:
	$(GO) vet ./...

## clean: Rimuove il binario e gli artefatti eBPF generati
clean:
	@echo "==> Pulizia artefatti..."
	rm -rf $(BUILD_DIR)
	rm -f bpf/bpf_bpfel.go bpf/bpf_bpfel.o bpf/bpf_bpfeb.go bpf/bpf_bpfeb.o

## help: Mostra questo messaggio di aiuto
help:
	@echo "Utilizzo: make [target]"
	@echo ""
	@sed -n 's/^##//p' $(MAKEFILE_LIST) | column -t -s ':' | sed -e 's/^/ /'